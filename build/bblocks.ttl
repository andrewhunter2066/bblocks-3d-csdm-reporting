<bblocks://csdm.reporting.reports.scheme-composition> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "Scheme Composition Report" ;
    dct:abstract "Structured report of what a strata scheme is made of: its member lots, how each is spatially represented, and a summary (member count, geometry types, representation statuses, whether every member is spatially resolved). The second report type of the register, built to test that the generic cadastral-report block serves more than one report."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-10-02T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://andrewhunter2066.github.io/bblocks-3d-csdm-reporting-clean/build/generateddocs/json-full/reporting/reports/scheme-composition/index.json> ],
        [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://andrewhunter2066.github.io/bblocks-3d-csdm-reporting-clean/bblock/csdm.reporting.reports.scheme-composition> ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://andrewhunter2066.github.io/bblocks-3d-csdm-reporting-clean/build/generateddocs/markdown/reporting/reports/scheme-composition/index.md> ] ;
    dct:hasVersion "0.1" ;
    dct:license [ rdfs:label "Apache-2.0" ;
            rdfs:seeAlso <https://www.apache.org/licenses/LICENSE-2.0> ] ;
    dct:modified "2026-10-02"^^xsd:date ;
    dct:source <https://github.com/surroundaustralia/3d-csdm-profile-wa/tree/main/proposals/development/built-strata> ;
    skos:inScheme <https://andrewhunter2066.github.io/bblocks-3d-csdm-reporting-clean/> ;
    skos:prefLabel "Scheme Composition Report" ;
    skos:topConceptOf <https://andrewhunter2066.github.io/bblocks-3d-csdm-reporting-clean/> ;
    dcat:keyword "3D",
        "cadastre",
        "reporting",
        "scheme composition",
        "strata" ;
    prof:hasResource [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://csdm.reporting.cadastral-report-ontology> ;
            prof:hasArtifact <https://andrewhunter2066.github.io/_sources/cadastral-report-ontology/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/json" ;
            prof:hasArtifact <https://andrewhunter2066.github.io/bblocks-3d-csdm-reporting-clean/build/annotated/reporting/reports/scheme-composition/schema.json> ;
            prof:hasRole role:schema ],
