            rdfs:isDefinedBy <https://andrewhunter2066.github.io/bblocks-3d-csdm-reporting-clean/build/generateddocs/markdown/reporting/adapters/wa-csdm/index.md> ] ;
    dct:hasVersion "0.1" ;
    dct:license [ rdfs:label "Apache-2.0" ;
