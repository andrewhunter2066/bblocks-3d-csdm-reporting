@prefix cr: <https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

[] dcterms:source [ dcterms:identifier "SP-1" ;
            cr:kind "dataset" ] ;
    dcterms:subject [ cr:kind "strata-scheme" ;
            cr:sourceRef [ cr:jsonPointer "/parcels/0/features/1" ;
                    cr:sourceDataset "SP-1" ] ] ;
    cr:content [ ] ;
    cr:reportType "example.report-type" ;
    cr:stage <https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/report-stage/facts> .

