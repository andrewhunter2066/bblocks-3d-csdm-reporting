@prefix cr: <https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] dcterms:source [ rdfs:label "DP 1" ;
            dcterms:conformsTo "example.profile" ;
            dcterms:identifier "example-dataset" ] ;
    dcterms:subject [ rdfs:label "Lot 1 on Plan DP 1" ;
            cr:kind "parcel" ;
            cr:sourceRef [ cr:jsonPointer "/parcels/0/features/0" ;
                    cr:sourceDataset "example-dataset" ;
                    cr:sourceObject "uuid:parcel-1" ] ] ;
    prov:wasGeneratedBy ( [ cr:buildingBlock "csdm.reporting.cadastral-report" ;
                cr:transform "summarise-checks" ] ) ;
    cr:check [ dcterms:description "The parcel has no area" ;
            dcterms:identifier "area-present" ;
            earl:outcome earl:failed ;
            sh:resultSeverity sh:Warning ;
            cr:checkCategory <https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/check-category/domain> ;
            cr:definedBy "example.report-type" ;
            cr:target "/content" ],
        [ dcterms:description "One parcel identified as the subject" ;
            dcterms:identifier "subject-identified" ;
            earl:outcome earl:passed ;
            sh:resultSeverity sh:Violation ;
            cr:checkCategory <https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/check-category/generation> ;
            cr:definedBy "example.adapter" ] ;
    cr:content [ ] ;
    cr:reportStatus <https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/report-status/incomplete> ;
    cr:reportType "example.report-type" ;
    cr:stage <https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/report-stage/complete> ;
    cr:statusSummary [ cr:checkCount 2 ;
            cr:failedErrors 0 ;
            cr:failedWarnings 1 ;
            cr:unevaluatedErrors 0 ] .

