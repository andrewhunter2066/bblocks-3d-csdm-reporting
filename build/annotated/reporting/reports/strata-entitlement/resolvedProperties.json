io/bblocks-3d-csdm-reporting/def/cadastral-report/sourceProperty"}],"4":[{"path":["status"],"const":"derived","sources":["bblocks://csdm.reporting.reports.strata-entitlement"]},{"path":["value"],"id":"http://www.w3.org/1999/02/22-rdf-syntax-ns#value","required":true,"schema_type":"integer","sources":["bblocks://csdm.reporting.reports.strata-entitlement"],"effectiveId":"http://www.w3.org/1999/02/22-rdf-syntax-ns#value"}]},"properties":[{"path":["_then"],"sources":["bblocks://csdm.reporting.cadastral-report"],"keyword":"then"},{"path":["_else"],"sources":["bblocks://csdm.reporting.cadastral-report"],"keyword":"else"},{"path":["reportType"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/reportType","description":"Identifier of the report-type building block that defines `content`.","required":true,"schema_type":"string","const":"csdm.reporting.reports.strata-entitlement","sources":["bblocks://csdm.reporting.cadastral-report","bblocks://csdm.reporting.reports.strata-entitlement"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/reportType"},{"path":["stage"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/stage","jsonld_type":"@vocab","description":"`facts`: source facts only, as produced by a source adapter. `complete`: derived values added by\nthe report-type building block. Both stages share this schema; report types state which members\neach stage requires.\n","required":true,"enum":["facts","complete"],"sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/stage"},{"path":["status"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/reportStatus","jsonld_type":"@vocab","description":"Overall report status, set from the check results by the generic `summarise-checks` transform when\nthe report is completed: `invalid` if any `error` check fails; otherwise `incomplete` if any\n`warning` check fails or any `error` check could not be evaluated; otherwise `complete`.\n","enum":["complete","incomplete","invalid"],"sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/reportStatus"},{"path":["statusSummary"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/statusSummary","description":"Counts behind `status`, recorded by `summarise-checks`.","schema_type":"object","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/statusSummary"},{"path":["statusSummary","checks"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/checkCount","schema_type":"integer","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/checkCount"},{"path":["statusSummary","failedErrors"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/failedErrors","schema_type":"integer","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/failedErrors"},{"path":["statusSummary","failedWarnings"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/failedWarnings","schema_type":"integer","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/failedWarnings"},{"path":["statusSummary","unevaluatedErrors"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/unevaluatedErrors","schema_type":"integer","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/unevaluatedErrors"},{"path":["checks"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/check","description":"Results of the checks run while generating the report (source adapter and report type).","schema_type":"array","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/check"},{"path":["checks","id"],"id":"http://purl.org/dc/terms/identifier","description":"Identifier of the check, unique within the building block that defines it.","required":true,"schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"http://purl.org/dc/terms/identifier"},{"path":["checks","definedBy"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/definedBy","description":"Identifier of the building block that defines (and ran) the check.","required":true,"schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/definedBy"},{"path":["checks","category"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/checkCategory","jsonld_type":"@vocab","description":"`source-conformance`: the source against its own profile. `generation`: what the report needs\nto be generated. `domain`: business rules of the report type.\n","required":true,"enum":["source-conformance","generation","domain"],"sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/checkCategory"},{"path":["checks","severity"],"id":"http://www.w3.org/ns/shacl#resultSeverity","jsonld_type":"@vocab","required":true,"enum":["error","warning","info"],"sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"http://www.w3.org/ns/shacl#resultSeverity"},{"path":["checks","outcome"],"id":"http://www.w3.org/ns/earl#outcome","jsonld_type":"@vocab","required":true,"enum":["pass","fail","not-evaluated","not-applicable"],"sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"http://www.w3.org/ns/earl#outcome"},{"path":["checks","message"],"id":"http://purl.org/dc/terms/description","required":true,"schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"http://purl.org/dc/terms/description"},{"path":["checks","targets"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/target","description":"Pointers to the report values the check is about.","schema_type":"array","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/target"},{"path":["checks","evidence"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/evidence","jsonld_type":"@json","description":"Small structured detail, for example the expected and actual values.","schema_type":"object","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/evidence"},{"path":["generatedBy"],"id":"http://www.w3.org/ns/prov#wasGeneratedBy","description":"Pipeline steps that produced this report, in order.","schema_type":"array","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"http://www.w3.org/ns/prov#wasGeneratedBy"},{"path":["generatedBy","bblock"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/buildingBlock","required":true,"schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/buildingBlock"},{"path":["generatedBy","transform"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/transform","required":true,"schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/transform"},{"path":["subject"],"id":"http://purl.org/dc/terms/subject","description":"The cadastral object the report is about (for example a strata scheme or a parcel).","required":true,"schema_type":"object","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"http://purl.org/dc/terms/subject"},{"path":["subject","kind"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/kind","description":"Kind of subject, for example `strata-scheme`.","required":true,"schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/kind"},{"path":["subject","label"],"id":"http://www.w3.org/2000/01/rdf-schema#label","schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"http://www.w3.org/2000/01/rdf-schema#label"},{"path":["subject","ref"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/sourceRef","required":true,"sources":["bblocks://csdm.reporting.cadastral-report"],"ref":"0","effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/sourceRef"},{"path":["sources"],"id":"http://purl.org/dc/terms/source","description":"Source datasets the report was generated from.","required":true,"schema_type":"array","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"http://purl.org/dc/terms/source"},{"path":["sources","id"],"id":"http://purl.org/dc/terms/identifier","required":true,"schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"http://purl.org/dc/terms/identifier"},{"path":["sources","kind"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-repor