adastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/unevaluatedErrors"},{"path":["checks"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/check","description":"Results of the checks run while generating the report (source adapter and report type).","schema_type":"array","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/check"},{"path":["checks","id"],"id":"http://purl.org/dc/terms/identifier","description":"Identifier of the check, unique within the building block that defines it.","required":true,"schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"http://purl.org/dc/terms/identifier"},{"path":["checks","definedBy"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/definedBy","description":"Identifier of the building block that defines (and ran) the check.","required":true,"schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/definedBy"},{"path":["checks","category"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/checkCategory","jsonld_type":"@vocab","description":"`source-conformance`: the source against its own profile. `generation`: what the report needs\nto be generated. `domain`: business rules of the report type.\n","required":true,"enum":["source-conformance","generation","domain"],"sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/checkCategory"},{"path":["checks","severity"],"id":"http://www.w3.org/ns/shacl#resultSeverity","jsonld_type":"@vocab","required":true,"enum":["error","warning","info"],"sources":["bblocks://csdm.reporting.cadastral-re