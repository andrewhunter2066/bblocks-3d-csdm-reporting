value","schema_type":"array","sources":["bblocks://csdm.reporting.reports.scheme-composition"],"effectiveId":"http://www.w3.org/1999/02/22-rdf-syntax-ns#value"}],"4":[{"path":["status"],"const":"derived","sources":["bblocks://csdm.reporting.reports.scheme-composition"]},{"path":["value"],"id":"http://www.w3.org/1999/02/22-rdf-syntax-ns#value","schema_type":"boolean","sources":["bblocks://csdm.reporting.reports.scheme-composition"],"effectiveId":"http://www.w3.org/1999/02/22-rdf-syntax-ns#value"}]},"properties":[{"path":["_then"],"sources":["bblocks://csdm.reporting.cadastral-report"],"keyword":"then"},{"path":["_else"],"sources":["bblocks://csdm.reporting.cadastral-report"],"keyword":"else"},{"path":["reportType"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/reportType","description":"Identifier of the report-type building block that defines `content`.","required":true,"schema_type":"string","const":"csdm.reporting.reports.scheme-composition","sources":["bblocks://csdm.reporting.cadastral-report","bblocks://csdm.reporting.reports.scheme-composition"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/reportType"},{"path":["stage"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/stage","jsonld_type":"@vocab","description":"`facts`: source facts only, as produced by a source adapter. `complete`: derived values added by\nthe report-type building block. Both stages share this schema; report types state which members\neach stage requires.\n","required":true,"enum":["facts","complete"],"sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/stage"},{"path":["status"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/reportStatus","jsonld_type":"@vocab","description":"Overall report status, set from the check results by the generic `