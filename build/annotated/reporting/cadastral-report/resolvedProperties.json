{"defs":{"0":[{"path":["dataset"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/sourceDataset","description":"Identifier of the source dataset (matches a `sources[].id`).","required":true,"schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/sourceDataset"},{"path":["id"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/sourceObject","description":"Identifier of the object in the source dataset, when it has one.","schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/sourceObject"},{"path":["pointer"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/jsonPointer","description":"JSON Pointer (RFC 6901) to the object within the source dataset.","required":true,"schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/jsonPointer"},{"path":["property"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/sourceProperty","jsonld_type":"@id","description":"IRI of the source property the value was read from, as defined by the source dataset's own\nsemantics (for example `https://w3id.org/ogc/ladm/parcels/entitlementPortion`). Given only when\nthe source profile defines one.\n","schema_type":"string","format":"iri","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/sourceProperty"}]},"properties":[{"path":["_then"],"sources":["bblocks://csdm.reporting.cadastral-report"],"keyword":"then"},{"path":["_else"],"sources":["bblocks://csdm.reporting.cadastral-report"],"keyword":"else"},{"path":["reportType"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/reportType","description":"Identifier of the report-type building block that defines `content`.","required":true,"schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/reportType"},{"path":["stage"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/stage","jsonld_type":"@vocab","description":"`facts`: source facts only, as produced by a source adapter. `complete`: derived values added by\nthe report-type building block. Both stages share this schema; report types state which members\neach stage requires.\n","required":true,"enum":["facts","complete"],"sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/stage"},{"path":["status"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/reportStatus","jsonld_type":"@vocab","description":"Overall report status, set from the check results by the generic `summarise-checks` transform when\nthe report is completed: `invalid` if any `error` check fails; otherwise `incomplete` if any\n`warning` check fails or any `error` check could not be evaluated; otherwise `complete`.\n","enum":["complete","incomplete","invalid"],"sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/reportStatus"},{"path":["statusSummary"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/statusSummary","description":"Counts behind `status`, recorded by `summarise-checks`.","schema_type":"object","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/statusSummary"},{"path":["statusSummary","checks"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/checkCount","schema_type":"integer","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/checkCount"},{"path":["statusSummary","failedErrors"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/failedErrors","schema_type":"integer","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/failedErrors"},{"path":["statusSummary","failedWarnings"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/failedWarnings","schema_type":"integer","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/failedWarnings"},{"path":["statusSummary","unevaluatedErrors"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/unevaluatedErrors","schema_type":"integer","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/unevaluatedErrors"},{"path":["checks"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/check","description":"Results of the checks run while generating the report (source adapter and report type).","schema_type":"array","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/check"},{"path":["checks","id"],"id":"http://purl.org/dc/terms/identifier","description":"Identifier of the check, unique within the building block that defines it.","required":true,"schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"http://purl.org/dc/terms/identifier"},{"path":["checks","definedBy"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/definedBy","description":"Identifier of the building block that defines (and ran) the check.","required":true,"schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/definedBy"},{"path":["checks","category"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/checkCategory","jsonld_type":"@vocab","description":"`source-conformance`: the source against its own profile. `generation`: what the report needs\nto be generated. `domain`: business rules of the report type.\n","required":true,"enum":["source-conformance","generation","domain"],"sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/checkCategory"},{"path":["checks","severity"],"id":"http://www.w3.org/ns/shacl#resultSeverity","jsonld_type":"@vocab","required":true,"enum":["error","warning","info"],"sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"http://www.w3.org/ns/shacl#resultSeverity"},{"path":["checks","outcome"],"id":"http://www.w3.org/ns/earl#outcome","jsonld_type":"@vocab","required":true,"enum":["pass","fail","not-evaluated","not-applicable"],"sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"http://www.w3.org/ns/earl#outcome"},{"path":["checks","message"],"id":"http://purl.org/dc/terms/description","required":true,"schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"http://purl.org/dc/terms/description"},{"path":["checks","targets"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/target","description":"Pointers to the report values the check is about.","schema_type":"array","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/target"},{"path":["checks","evidence"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/evidence","jsonld_type":"@json","description":"Small structured detail, for example the expected and actual values.","schema_type":"object","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/evidence"},{"path":["generatedBy"],"id":"http://www.w3.org/ns/prov#wasGeneratedBy","description":"Pipeline steps that produced this report, in order.","schema_type":"array","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"http://www.w3.org/ns/prov#wasGeneratedBy"},{"path":["generatedBy","bblock"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/buildingBlock","required":true,"schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/buildingBlock"},{"path":["generatedBy","transform"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/transform","required":true,"schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/transform"},{"path":["subject"],"id":"http://purl.org/dc/terms/subject","description":"The cadastral object the report is about (for example a strata scheme or a parcel).","required":true,"schema_type":"object","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"http://purl.org/dc/terms/subject"},{"path":["subject","kind"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/kind","description":"Kind of subject, for example `strata-scheme`.","required":true,"schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/kind"},{"path":["subject","label"],"id":"http://www.w3.org/2000/01/rdf-schema#label","schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"http://www.w3.org/2000/01/rdf-schema#label"},{"path":["subject","ref"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/sourceRef","required":true,"sources":["bblocks://csdm.reporting.cadastral-report"],"ref":"0","effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/sourceRef"},{"path":["sources"],"id":"http://purl.org/dc/terms/source","description":"Source datasets the report was generated from.","required":true,"schema_type":"array","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"http://purl.org/dc/terms/source"},{"path":["sources","id"],"id":"http://purl.org/dc/terms/identifier","required":true,"schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"http://purl.org/dc/terms/identifier"},{"path":["sources","kind"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/kind","enum":["dataset","vocabulary"],"sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/kind"},{"path":["sources","name"],"id":"http://www.w3.org/2000/01/rdf-schema#label","schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"http://www.w3.org/2000/01/rdf-schema#label"},{"path":["sources","date"],"id":"http://purl.org/dc/terms/date","schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"http://purl.org/dc/terms/date"},{"path":["sources","conformsTo"],"id":"http://purl.org/dc/terms/conformsTo","description":"Identifier of the profile or specification the dataset follows.","schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"http://purl.org/dc/terms/conformsTo"},{"path":["documents"],"id":"http://purl.org/dc/terms/references","description":"Supporting documents the report relies on (not every document of the source dataset).","schema_type":"array","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"http://purl.org/dc/terms/references"},{"path":["documents","id"],"id":"http://purl.org/dc/terms/identifier","description":"Identifier of the document within this report (used by `documentRef`).","required":true,"schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"http://purl.org/dc/terms/identifier"},{"path":["documents","title"],"id":"http://purl.org/dc/terms/title","schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"http://purl.org/dc/terms/title"},{"path":["documents","href"],"id":"https://schema.org/url","description":"Link to the document, as given by the source (may be relative).","required":true,"schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://schema.org/url"},{"path":["documents","mediaType"],"id":"http://purl.org/dc/terms/format","schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"http://purl.org/dc/terms/format"},{"path":["documents","role"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/role","description":"Role of the document, as given by the source (an IRI or CURIE).","schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/role"},{"path":["documents","conformsTo"],"id":"http://purl.org/dc/terms/conformsTo","description":"Specification or approved form the document follows (an IRI or CURIE).","schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"http://purl.org/dc/terms/conformsTo"},{"path":["documents","sourceRef"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/sourceRef","required":true,"sources":["bblocks://csdm.reporting.cadastral-report"],"ref":"0","effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/sourceRef"},{"path":["annotations"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/annotation","description":"Source annotations the report relies on (for example a certification).","schema_type":"array","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/annotation"},{"path":["annotations","id"],"id":"http://purl.org/dc/terms/identifier","description":"Identifier of the annotation within this report (used by `annotationRef`).","required":true,"schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"http://purl.org/dc/terms/identifier"},{"path":["annotations","role"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/role","description":"Role of the annotation, as given by the source (an IRI or CURIE).","required":true,"schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/role"},{"path":["annotations","statement"],"id":"http://purl.org/dc/terms/description","description":"The annotation text, verbatim.","schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"http://purl.org/dc/terms/description"},{"path":["annotations","href"],"id":"https://schema.org/url","schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://schema.org/url"},{"path":["annotations","rel"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/linkRelation","schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/linkRelation"},{"path":["annotations","documentRef"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/documentRef","description":"The document in `documents` that the annotation links to, if any.","schema_type":"string","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/documentRef"},{"path":["annotations","sourceRef"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/sourceRef","required":true,"sources":["bblocks://csdm.reporting.cadastral-report"],"ref":"0","effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/sourceRef"},{"path":["content"],"id":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/content","description":"Report-type specific content, defined by the report-type building block.","required":true,"schema_type":"object","sources":["bblocks://csdm.reporting.cadastral-report"],"effectiveId":"https://ogcincubator.github.io/bblocks-3d-csdm-reporting/def/cadastral-report/content"}]}