    {
      "itemIdentifier": "csdm.reporting.cadastral-report",
      "name": "Cadastral report",
      "abstract": "Generic envelope for structured cadastral reports: report type, subject, source datasets and a report-specific content section. Report-type building blocks extend it; it knows nothing about any jurisdiction, source format or report type.",
      "status": "under-development",
      "dateTimeAddition": "2026-10-01T00:00:00Z",
