          "url": "https://andrewhunter2066.github.io/bblocks-3d-csdm-reporting/bblock/csdm.reporting.reports.scheme-composition"
        }
      },
      "@id": "bblocks://csdm.reporting.reports.scheme-composition",
      "@type": [
        "bblocks:Schema",
